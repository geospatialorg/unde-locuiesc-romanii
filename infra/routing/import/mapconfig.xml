<?xml version="1.0" encoding="UTF-8"?>
<!-- Configurație osm2pgrouting pentru autoturisme: clase de drum + viteze implicite (km/h).
     Rețeaua importată e cea filtrată de import.sh (fără residential/service — vezi nota din README). -->
<configuration>
  <tag_name name="highway" id="1">
    <tag_value name="motorway"       id="101" priority="1.0"  maxspeed="120" />
    <tag_value name="motorway_link"  id="102" priority="1.0"  maxspeed="60" />
    <tag_value name="trunk"          id="103" priority="1.05" maxspeed="100" />
    <tag_value name="trunk_link"     id="104" priority="1.05" maxspeed="60" />
    <tag_value name="primary"        id="105" priority="1.1"  maxspeed="90" />
    <tag_value name="primary_link"   id="106" priority="1.1"  maxspeed="50" />
    <tag_value name="secondary"      id="107" priority="1.2"  maxspeed="70" />
    <tag_value name="secondary_link" id="108" priority="1.2"  maxspeed="50" />
    <tag_value name="tertiary"       id="109" priority="1.3"  maxspeed="60" />
    <tag_value name="tertiary_link"  id="110" priority="1.3"  maxspeed="40" />
    <tag_value name="unclassified"   id="111" priority="1.4"  maxspeed="50" />
    <tag_value name="residential"    id="112" priority="1.5"  maxspeed="30" />
  </tag_name>
</configuration>
