# Copiază numai local valorile proprii; acest fișier nu conține credențiale.
ADS_API_URL=https://ads.atmosphere.copernicus.eu/api
ADS_API_KEY=
FORECAST_INTERVAL=21600

# Producție (VM): parola bazei de rutare (rețea internă Docker, dar pune ceva propriu)
ROUTING_DB_PASSWORD=ulrpass

# Portul de HOST spre care duce nginx-ul tău (exotic, ca să nu se ciocnească cu 8080).
# Rămâne pe 127.0.0.1; alege sub 32768 ca să eviți intervalul de porturi efemere.
APP_PORT=28173
