# sursele brute din data/ — nu intră în git…
/data/*
# …dar produsele runtime din data/out intră (deploy prin push, fără sync manual):
# registry + parquet-uri (core/env/climate/county_climate) + geojson-uri + gazetteer.
!/data/out/
# excepții: cubul Zarr (9G, doar pt rebuild) și fișierele live (rescrise pe VM la 6h)
/data/out/climate.zarr/
/data/out/live/

